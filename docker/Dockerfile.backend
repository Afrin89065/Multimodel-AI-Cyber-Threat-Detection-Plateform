FROM python:3.11-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev libssl-dev libffi-dev curl git \
    libglib2.0-0 libsm6 libxext6 libxrender-dev libgomp1 cmake \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    torch==2.2.0 torchvision==0.17.0 \
    --index-url https://download.pytorch.org/whl/cpu

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

RUN python -c "import open_clip; open_clip.create_model_and_transforms('ViT-B-32', pretrained='openai'); print('CLIP cached')" \
    || echo "CLIP will download on first use"

RUN python -c "from transformers import AutoTokenizer; AutoTokenizer.from_pretrained('ehsanaghaei/SecureBERT'); print('SecureBERT tokenizer cached')" \
    || echo "SecureBERT will download on first use"

COPY backend/ .
COPY explainability/ /app/explainability/
COPY models_store/ /app/models_store/

RUN adduser --disabled-password --gecos "" aidtect && chown -R aidtect:aidtect /app
USER aidtect
RUN mkdir -p logs

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=15s --retries=5 --start-period=120s \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]